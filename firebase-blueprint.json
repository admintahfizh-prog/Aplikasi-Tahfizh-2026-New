{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Tahfizh student data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nis": { "type": "string" },
        "nisn": { "type": "string" },
        "name": { "type": "string" },
        "gender": { "type": "string" },
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "program": { "type": "string" },
        "targetJuz": { "type": "number" },
        "totalJuzHafal": { "type": "number" },
        "currentUmmiJilid": { "type": "string" },
        "currentUmmiPage": { "type": "number" }
      },
      "required": ["id", "nis", "name", "gender", "classId"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Tahfizh teacher data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "name": { "type": "string" },
        "specialization": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ClassItem": {
      "title": "ClassItem",
      "description": "School class entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "homeroomTeacherId": { "type": "string" }
      },
      "required": ["id", "name", "level"]
    },
    "MemorizationRecord": {
      "title": "MemorizationRecord",
      "description": "Daily Quran memorization deposit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string" },
        "startAyah": { "type": "number" },
        "endAyah": { "type": "number" },
        "finalScore": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["id", "studentId", "teacherId", "date", "surahName"]
    },
    "UmmiRecord": {
      "title": "UmmiRecord",
      "description": "Ummi method reading record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "jilid": { "type": "string" },
        "page": { "type": "number" },
        "score": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentId", "teacherId", "date", "jilid", "page"]
    },
    "User": {
      "title": "User",
      "description": "App user credential and role profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "password": { "type": "string" }
      },
      "required": ["id", "username", "role"]
    },
    "HalaqahGroup": {
      "title": "HalaqahGroup",
      "description": "Tahfizh halaqah study group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "description": { "type": "string" },
        "schedule": { "type": "string" },
        "room": { "type": "string" },
        "maxCapacity": { "type": "number" },
        "createdAt": { "type": "string" },
        "studentIds": { "type": "array" }
      },
      "required": ["id", "name", "teacherId"]
    },
    "TargetProgress": {
      "title": "TargetProgress",
      "description": "Student memorization target and achievement tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "targetJuz": { "type": "number" },
        "achievedJuz": { "type": "number" },
        "percentage": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentId", "targetJuz"]
    },
    "LearningMaterial": {
      "title": "LearningMaterial",
      "description": "Quran & Ummi learning guides and tajweed syllabus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "TahfizhViolation": {
      "title": "TahfizhViolation",
      "description": "Discipline and violation records in tahfizh activities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "violationType": { "type": "string" },
        "points": { "type": "number" }
      },
      "required": ["id", "studentId", "date"]
    },
    "MatrikulasiStudent": {
      "title": "MatrikulasiStudent",
      "description": "Students enrolled in basic Quranic matriculation (Iqro)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "currentIqroJilid": { "type": "string" },
        "currentIqroPage": { "type": "number" }
      },
      "required": ["id", "studentId"]
    },
    "MatrikulasiRecord": {
      "title": "MatrikulasiRecord",
      "description": "Daily reading and examination records for Iqro matriculation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string" },
        "jilid": { "type": "string" },
        "page": { "type": "number" }
      },
      "required": ["id", "studentId", "date", "jilid"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application settings and school identity",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "kkmHafalan": { "type": "number" },
        "academicYear": { "type": "string" }
      },
      "required": ["schoolName"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Collection of students"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Collection of teachers"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassItem" },
      "description": "Collection of classes"
    },
    "/memorization_records/{recordId}": {
      "schema": { "$ref": "#/entities/MemorizationRecord" },
      "description": "Collection of memorization records"
    },
    "/ummi_records/{recordId}": {
      "schema": { "$ref": "#/entities/UmmiRecord" },
      "description": "Collection of Ummi records"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of system users"
    },
    "/halaqah_groups/{groupId}": {
      "schema": { "$ref": "#/entities/HalaqahGroup" },
      "description": "Collection of tahfizh halaqah groups"
    },
    "/targets/{targetId}": {
      "schema": { "$ref": "#/entities/TargetProgress" },
      "description": "Collection of target progress"
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/LearningMaterial" },
      "description": "Collection of learning materials"
    },
    "/violations/{violationId}": {
      "schema": { "$ref": "#/entities/TahfizhViolation" },
      "description": "Collection of violations"
    },
    "/matrikulasi_students/{studentId}": {
      "schema": { "$ref": "#/entities/MatrikulasiStudent" },
      "description": "Collection of matriculation students"
    },
    "/matrikulasi_records/{recordId}": {
      "schema": { "$ref": "#/entities/MatrikulasiRecord" },
      "description": "Collection of matriculation records"
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Application configuration"
    }
  }
}
